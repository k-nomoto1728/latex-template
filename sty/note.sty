\NeedsTeXFormat{LaTeX2e}[2024-11-01]
\ProvidesPackage{sty/note}[2026-04-20 v1.4 Note package]

\RequirePackage{sty/core} % 一番最初に読み込む

\RequirePackage{sty/bib}
\RequirePackage{sty/code}
\RequirePackage{sty/layout}
\RequirePackage{sty/math}

\RequirePackage{hyperref}
\RequirePackage{bookmark}

\pdfstringdefDisableCommands{%
  \let\inhibitglue\empty
}

\hypersetup{
  unicode,
  bookmarksnumbered=true,
  hidelinks,
  hypertexnames=false,
}

\RequirePackage{sty/ref}
\RequirePackage{sty/theorem}

